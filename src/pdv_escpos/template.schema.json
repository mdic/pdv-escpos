{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pdv-escpos.local/template.schema.json",
  "title": "pdv-escpos template module",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": { "type": "string", "minLength": 1 },
    "template": { "type": "string", "default": "template.html.j2" },
    "stylesheet": { "type": "string", "default": "style.css" },
    "generator": { "type": "string" },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "family": { "type": "string", "default": "ReceiptPixel" },
        "format": {
          "type": "string",
          "enum": ["truetype", "opentype", "woff2"],
          "default": "truetype"
        }
      }
    },
    "options": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/definitions/option" }
    }
  },
  "definitions": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "flags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^-{1,2}[a-zA-Z0-9]" }
        },
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "path"],
          "default": "string"
        },
        "help": { "type": "string" },
        "default": {},
        "required": { "type": "boolean", "default": false },
        "repeatable": { "type": "boolean", "default": false },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
