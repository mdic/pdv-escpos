{
  "$schema": "http://json-schema.org/draft-07/schema#",

  "title": "pdv-escpos template module",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": { "type": "string", "minLength": 1 },
    "template": { "type": "string", "default": "template.html.j2" },
    "stylesheet": { "type": "string", "default": "style.css" },
    "generator": { "type": "string" },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "type": "string",
          "enum": ["portrait", "landscape"],
          "default": "portrait"
        },
        "canvas_length": { "type": "integer", "minimum": 384 },
        "canvas_length_from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "font": { "$ref": "#/definitions/font" },
    "fonts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/font" }
    },
    "options": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/definitions/option" }
    }
  },
  "definitions": {
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "family": { "type": "string" },
        "format": {
          "type": "string",
          "enum": ["truetype", "opentype", "woff", "woff2"]
        },
        "weight": { "type": ["string", "integer"] },
        "style": {
          "type": "string",
          "enum": ["normal", "italic", "oblique"],
          "default": "normal"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "flags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^-{1,2}[a-zA-Z0-9]" }
        },
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "path"],
          "default": "string"
        },
        "help": { "type": "string" },
        "default": {},
        "required": { "type": "boolean", "default": false },
        "repeatable": { "type": "boolean", "default": false },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
